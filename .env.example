# nemdb environment variables
# Copy to .env and fill in values as needed.
# None of these are required — defaults are shown in comments.

# ── Storage ───────────────────────────────────────────────────────────────────

# Root directory for all cached data: NEMWEB parquets, DNSP parquets,
# geodata, and pooch-managed assets (ISP_2025.zip, facilities_nem.parquet).
# Default: ~/.nemdb_cache
# NEMDB_CACHE_DIR=/data/nemdb

# fsspec filesystem backend. Use "local" for on-disk storage or "gcs" for
# Google Cloud Storage (requires gcsfs). When using a cloud backend, set
# NEMDB_CACHE_DIR to the corresponding bucket URI (e.g. gs://my-bucket/nemdb).
# Default: local
# NEMDB_FILESYSTEM=local

# ── Pooch data asset overrides ────────────────────────────────────────────────

# Absolute path to a local copy of the ISP 2025 workbook zip (ISP_2025.zip).
# When set, pooch download from the data-v1 GitHub release is skipped entirely.
# Useful for air-gapped environments or testing against a custom spreadsheet.
# Default: (not set — downloaded and cached automatically)
# NEMDB_ISP_2025=/data/ISP_2025.zip

# Absolute path to a local NEM facilities parquet (facilities_nem.parquet).
# When set, pooch download from the data-v2 GitHub release is skipped entirely.
# Regenerate with: uv run scripts/extract_facilities.py --output /data/facilities_nem.parquet
# Default: (not set — downloaded and cached automatically)
# NEMDB_FACILITIES=/data/facilities_nem.parquet

# ── OpenElectricity API ───────────────────────────────────────────────────────

# API key for the OpenElectricity client.
# Only required when using source="api" in match_facilities_to_gis() or
# calling read_facilities() directly. Not needed when using the pooch default.
# OPENELECTRICITY_API_KEY=your-api-key-here
